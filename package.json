{
  "name": "link-mvp-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "kakaopay:local": "node --experimental-strip-types scripts/kakaopay-local.ts",
    "qa:render": "node --experimental-strip-types scripts/kakaopay-local.ts --qa",
    "qa:vercel": "node --experimental-strip-types scripts/qa-vercel.ts --check && npm run build -- --outDir .vercel/output/static && node --experimental-strip-types scripts/qa-vercel.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react-native": "0.88.1",
    "typescript": "^6.0.3",
    "vite": "8.3.6",
    "vitest": "^4.0.0"
  }
}
